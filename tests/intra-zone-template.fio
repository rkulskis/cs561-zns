[single_zone_write]
filename=/dev/nvme0n1        # ZNS device under test
zonemode=zbd                 # Zoned block device mode
ioengine=psync               # Use synchronous writes
direct=1                     # Direct I/O (no cache)
rw=write                     # Sequential write pattern
bs=128k                      # 128 KiB block size for writes
zonesize=64M                 # Write one zone worth of data
size=64M
iodepth=1 